{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=KtcApiExplorer;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "Provider": "SqlServer",
    "Initialize": "None"
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminPassword": ""
  },
  "Ktc": {
    "DefaultBaseUrl": "https://localhost/KTCRESTAPI",
    "RequestTimeoutSeconds": 60,
    "TokenRefreshSkewSeconds": 90,
    "DefaultTokenLifetimeMinutes": 20,
    "StoreCredentialsForRefresh": true,
    "AllowInvalidCertificates": false,
    "SessionIdleMinutes": 60
  },
  "Execution": {
    "MaxResponseBytes": 5242880,
    "StoreResponseBody": true,
    "MaxStoredBodyChars": 32000
  },
  "Ai": {
    "Provider": "Heuristic",
    "Model": "claude-sonnet-5-5",
    "ApiKey": ""
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}" } },
      { "Name": "File", "Args": { "path": "logs/ktc-explorer-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14, "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*"
}
