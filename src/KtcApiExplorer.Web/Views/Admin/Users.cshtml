@model UsersViewModel
@{ ViewData["Title"] = "Users"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">Users &amp; roles</h1><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal" data-new="1"><i class="bi bi-person-plus"></i> New user</button></div>
<div class="alert alert-secondary small"><b>Admin</b> - import collections, manage users, audit log · <b>Developer</b> - execute any method, save templates/test cases · <b>Viewer</b> - browse and execute GET/HEAD only.</div>
<div class="card"><div class="table-responsive"><table class="table table-sm align-middle mb-0">
  <thead><tr><th>User</th><th>Display name</th><th>Email</th><th>Role</th><th>Active</th><th>Last login</th><th></th></tr></thead><tbody>
  @foreach (var u in Model.Users)
  {
    <tr><td class="mono">@u.UserName</td><td>@u.DisplayName</td><td>@u.Email</td><td><span class="badge text-bg-secondary">@u.Role</span></td><td>@(u.IsActive ? "yes" : "no")</td><td class="small">@(u.LastLoginUtc?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
      <td><button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#userModal" data-id="@u.Id" data-user="@u.UserName" data-display="@u.DisplayName" data-email="@u.Email" data-role="@u.Role" data-active="@(u.IsActive ? "1" : "0")"><i class="bi bi-pencil"></i></button></td></tr>
  }</tbody></table></div></div>
<div class="modal fade" id="userModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" asp-action="SaveUser" method="post" autocomplete="off">
  <div class="modal-header"><h2 class="modal-title h5" id="userModalTitle">User</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
    <input type="hidden" name="Id" id="uId" />
    <div class="mb-2"><label class="form-label">User name</label><input class="form-control" name="UserName" id="uUser" required maxlength="100" /></div>
    <div class="mb-2"><label class="form-label">Display name</label><input class="form-control" name="DisplayName" id="uDisplay" required /></div>
    <div class="mb-2"><label class="form-label">Email</label><input class="form-control" type="email" name="Email" id="uEmail" /></div>
    <div class="mb-2"><label class="form-label">Role</label><select class="form-select" name="Role" id="uRole">@foreach (var r in Model.Roles) { <option>@r</option> }</select></div>
    <div class="mb-2"><label class="form-label">Password <span class="text-body-secondary" id="uPwHint"></span></label><input class="form-control" type="password" name="Password" id="uPw" autocomplete="new-password" /><div class="form-text">Min 10 characters with upper-case, lower-case and a digit.</div></div>
    <div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" id="uActive" value="true" checked /><label class="form-check-label" for="uActive">Active</label></div>
  </div>
  <div class="modal-footer"><button class="btn btn-primary" type="submit">Save</button></div></form></div></div>
@section Scripts { <script src="~/js/admin-users.js" asp-append-version="true"></script> }
