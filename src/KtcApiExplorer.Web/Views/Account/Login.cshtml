@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="row justify-content-center mt-5">
  <div class="col-12 col-sm-8 col-md-5 col-lg-4">
    <div class="text-center mb-4"><i class="bi bi-diagram-3-fill text-primary" style="font-size:2.5rem"></i><h1 class="h4 mt-2">KTC API Explorer</h1><p class="text-body-secondary mb-0">Sign in with your explorer account</p></div>
    <div class="card shadow-sm"><div class="card-body p-4">
      @if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger py-2">@Model.Error</div> }
      <form method="post" asp-action="Login" autocomplete="on">
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-3"><label class="form-label" asp-for="UserName">User name</label><input class="form-control" asp-for="UserName" autocomplete="username" autofocus /><span class="text-danger small" asp-validation-for="UserName"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Password">Password</label><input class="form-control" asp-for="Password" autocomplete="current-password" /></div>
        <button class="btn btn-primary w-100" type="submit">Sign in</button>
      </form>
    </div></div>
    <p class="text-center text-body-secondary small mt-3">This is separate from the KTC API sign-in, which you do after this step.</p>
  </div>
</div>
