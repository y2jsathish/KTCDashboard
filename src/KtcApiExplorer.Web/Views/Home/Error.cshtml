@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="text-center mt-5"><div class="display-4 text-body-secondary">@Model.Code</div><h1 class="h4">@Model.Title</h1>
@if (!string.IsNullOrEmpty(Model.CorrelationId)) { <p class="text-body-secondary small">Reference: <code>@Model.CorrelationId</code></p> }
<a class="btn btn-primary" href="/">Back to dashboard</a></div>
